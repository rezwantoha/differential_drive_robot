<?xml version="1.0"?>

<robot name="diff_drive_robot">

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <material name="body_blue">
                <color rgba="0.18 0.32 0.55 1"/>
            </material>
            
        </visual>

        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            
        </collision>

        <inertial>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <mass value="5.0"/>

            <inertia
                ixx="0.0833"
                ixy="0.0"
                ixz="0.0"
                iyy="0.1667"
                iyz="0.0"
                izz="0.2167"/>
        </inertial>

    </link>

    <link name="left_wheel_link">

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.075" length="0.05"/>
            </geometry>
            <material name="wheel_dark">
                <color rgba="0.06 0.07 0.08 1"/>
            </material>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.075" length="0.05"/>
            </geometry>
            <material name="wheel_dark"/>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.000807"
                ixy="0.0"
                ixz="0.0"
                iyy="0.001406"
                iyz="0.0"
                izz="0.000807"/>
        </inertial>

</link>

    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel_link"/>

        <origin xyz="0 0.2 0.075" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>

    <link name="right_wheel_link">

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.075" length="0.05"/>
            </geometry>
            <material name="wheel_dark"/>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.075" length="0.05"/>
            </geometry>
            <material name="wheel_dark"/>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia
                ixx="0.000807"
                ixy="0.0"
                ixz="0.0"
                iyy="0.001406"
                iyz="0.0"
                izz="0.000807"/>
        </inertial>

    </link>
    <joint name="right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel_link"/>

        <origin xyz="0 -0.2 0.075" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="lidar_orange">
                <color rgba="0.9 0.45 0.08 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.1"/>
            <inertia
                ixx="0.0001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0001"
                iyz="0.0"
                izz="0.0001"/>
        </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.27" rpy="0 0 0"/>
    </joint>
    <gazebo reference="lidar_link">
        <sensor name="gpu_lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>

            <topic>/scan</topic>
            <frame_id>lidar_link</frame_id>
            <update_rate>5</update_rate>

            <ray>
                <scan>
                    <horizontal>
                        <samples>180</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>

                <range>
                    <min>0.1</min>
                    <max>5.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>

            <always_on>true</always_on>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <wheel_separation>0.4</wheel_separation>
            <wheel_radius>0.075</wheel_radius>

            <topic>/cmd_vel_gazebo</topic>

            <odom_publish_frequency>0</odom_publish_frequency>

        </plugin>
</gazebo>

</robot>