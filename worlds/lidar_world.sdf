<?xml version="1.0" ?>

<sdf version="1.9">

    <world name="lidar_world">

        <!-- ========================================================= -->
        <!-- Physics -->
        <!-- ========================================================= -->

        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>

        <physics name="1ms" type="ode">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>


        <!-- ========================================================= -->
        <!-- Scene Broadcaster -->
        <!-- ========================================================= -->

        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>


        <!-- ========================================================= -->
        <!-- Sensors -->
        <!-- ========================================================= -->

        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>


        <!-- ========================================================= -->
        <!-- User Commands -->
        <!-- ========================================================= -->

        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>


        <!-- ========================================================= -->
        <!-- Ground -->
        <!-- ========================================================= -->

        <model name="ground">

            <static>true</static>

            <link name="ground_link">

                <collision name="collision">

                    <geometry>

                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>

                    </geometry>

                </collision>


                <visual name="visual">

                    <geometry>

                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>

                    </geometry>


                    <material>

                        <ambient>
                            0.25 0.27 0.30 1
                        </ambient>

                        <diffuse>
                            0.35 0.37 0.40 1
                        </diffuse>

                        <specular>
                            0.05 0.05 0.05 1
                        </specular>

                    </material>

                </visual>

            </link>

        </model>


        <!-- ========================================================= -->
        <!-- Wall -->
        <!-- ========================================================= -->

        <model name="wall">

            <static>true</static>

            <pose>
                3 0 0.5 0 0 0
            </pose>

            <link name="wall_link">

                <collision name="collision">

                    <geometry>

                        <box>
                            <size>0.2 4 1</size>
                        </box>

                    </geometry>

                </collision>


                <visual name="visual">

                    <geometry>

                        <box>
                            <size>0.2 4 1</size>
                        </box>

                    </geometry>


                    <material>

                        <ambient>
                            0.75 0.75 0.72 1
                        </ambient>

                        <diffuse>
                            0.85 0.85 0.82 1
                        </diffuse>

                        <specular>
                            0.1 0.1 0.1 1
                        </specular>

                    </material>

                </visual>

            </link>

        </model>


        <!-- ========================================================= -->
        <!-- Decorative Tree 1 -->
        <!-- Visual only - no collision -->
        <!-- ========================================================= -->

        <model name="tree_1">

            <static>true</static>

            <pose>
                2.3 1.5 0 0 0 0
            </pose>

            <link name="tree_link">

                <!-- Trunk -->

                <visual name="trunk">

                    <pose>
                        0 0 1 0 0 0
                    </pose>

                    <geometry>

                        <cylinder>
                            <radius>0.12</radius>
                            <length>2.0</length>
                        </cylinder>

                    </geometry>


                    <material>

                        <ambient>
                            0.25 0.12 0.04 1
                        </ambient>

                        <diffuse>
                            0.40 0.20 0.06 1
                        </diffuse>

                    </material>

                </visual>


                <!-- Leaves -->

                <visual name="leaves">

                    <pose>
                        0 0 2.2 0 0 0
                    </pose>

                    <geometry>

                        <sphere>
                            <radius>0.8</radius>
                        </sphere>

                    </geometry>


                    <material>

                        <ambient>
                            0.08 0.30 0.08 1
                        </ambient>

                        <diffuse>
                            0.12 0.45 0.12 1
                        </diffuse>

                    </material>

                </visual>

            </link>

        </model>


        <!-- ========================================================= -->
        <!-- Decorative Tree 2 -->
        <!-- Visual only - no collision -->
        <!-- ========================================================= -->

        <model name="tree_2">

            <static>true</static>

            <pose>
                3.8 -1.5 0 0 0 0
            </pose>

            <link name="tree_link">

                <!-- Trunk -->

                <visual name="trunk">

                    <pose>
                        0 0 1 0 0 0
                    </pose>

                    <geometry>

                        <cylinder>
                            <radius>0.12</radius>
                            <length>2.0</length>
                        </cylinder>

                    </geometry>


                    <material>

                        <ambient>
                            0.25 0.12 0.04 1
                        </ambient>

                        <diffuse>
                            0.40 0.20 0.06 1
                        </diffuse>

                    </material>

                </visual>


                <!-- Leaves -->

                <visual name="leaves">

                    <pose>
                        0 0 2.2 0 0 0
                    </pose>

                    <geometry>

                        <sphere>
                            <radius>0.8</radius>
                        </sphere>

                    </geometry>


                    <material>

                        <ambient>
                            0.08 0.30 0.08 1
                        </ambient>

                        <diffuse>
                            0.12 0.45 0.12 1
                        </diffuse>

                    </material>

                </visual>

            </link>

        </model>


        <!-- ========================================================= -->
        <!-- Directional Light -->
        <!-- ========================================================= -->

        <light type="directional" name="sun">

            <cast_shadows>true</cast_shadows>

            <pose>
                0 0 10 0 0 0
            </pose>

            <diffuse>
                1 1 1 1
            </diffuse>

            <specular>
                1 1 1 1
            </specular>

            <direction>
                0 5 -10
            </direction>

        </light>


    </world>

</sdf>